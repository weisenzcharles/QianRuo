# Copy to deploy/.env.aliyun. Do not commit the copied file.

# Alibaba Cloud Container Registry (ACR). Use the registry domain shown by ACR.
# Examples: registry.cn-hangzhou.aliyuncs.com or crpi-xxxx.cn-hangzhou.personal.cr.aliyuncs.com
ALIYUN_REGISTRY=registry.example.aliyuncs.com
ALIYUN_IMAGE_NAMESPACE=your-namespace
# The wrapper defaults to the full current Git SHA; do not use latest.
IMAGE_TAG=

# Alibaba Cloud Container Service for Kubernetes (ACK).
ALIYUN_K8S_NAMESPACE=qianruo
ALIYUN_KUBE_CONTEXT=
ALIYUN_STORAGE_CLASS_NAME=alicloud-disk-topology
# ACK 节点通常为 amd64；如集群架构不同请按 kubectl 节点信息调整。
ALIYUN_IMAGE_PLATFORM=linux/amd64
# Optional path to the kubeconfig downloaded from the ACK console.
ALIYUN_KUBECONFIG=

# Optional Ingress hosts.
ALIYUN_ADMIN_HOST=
ALIYUN_MERCHANT_HOST=

# ACR login. Prefer RAM credentials or an existing `docker login`; never commit this file.
ALIYUN_DOCKER_LOGIN=true
ALIYUN_REGISTRY_USERNAME=
ALIYUN_REGISTRY_PASSWORD=

# Optional private-ACR pull secret. Leave empty when ACK node/RAM permissions already allow pulls.
ALIYUN_IMAGE_PULL_SECRET_NAME=
ALIYUN_REGISTRY_SERVER=

# Required runtime secrets. Keep these values consistent with the target environment.
MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD
PLATFORM_DB_USERNAME=qianruo_platform
PLATFORM_DB_PASSWORD=CHANGE_ME_PLATFORM_DB_PASSWORD
MERCHANT_DB_USERNAME=qianruo_merchant
MERCHANT_DB_PASSWORD=CHANGE_ME_MERCHANT_DB_PASSWORD
BUSINESS_DB_USERNAME=qianruo_business
BUSINESS_DB_PASSWORD=CHANGE_ME_BUSINESS_DB_PASSWORD
NACOS_AUTH_TOKEN=CHANGE_ME_BASE64_SECRET_AT_LEAST_32_BYTES
NACOS_IMAGE=nacos/nacos-server:v3.0.2
NACOS_AUTH_IDENTITY_KEY=serverIdentity
NACOS_AUTH_IDENTITY_VALUE=CHANGE_ME_IDENTITY_VALUE

# File uploads use OSS. Endpoint, bucket and the shared Aliyun AccessKey are
# managed in the platform system configuration, not in deployment environment variables.
FILE_STORAGE_PROVIDER=aliyun-oss

# Keep schema migrations enabled for normal ACK releases; business test fixtures are not included.
BUILD_BACKEND=true
BUILD_FRONTEND=true
BUILD_IMAGES=true
PUSH_IMAGES=true
APPLY_MANIFESTS=true
INIT_DB=false
MIGRATE_DB=true

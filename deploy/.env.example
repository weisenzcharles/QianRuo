# Copy this file to deploy/.env and adjust values before deployment.

# Container registry. For Volcengine CR, use the registry address from your namespace page.
REGISTRY=cr-<region>.volces.com
IMAGE_NAMESPACE=qianruo
IMAGE_TAG=

# Kubernetes target.
K8S_NAMESPACE=qianruo
KUBE_CONTEXT=

# Optional ingress hosts. Leave empty if your cloud load balancer binds later.
ADMIN_HOST=admin.example.com
MERCHANT_HOST=merchant.example.com

# Runtime secrets. Replace before running ./scripts/deploy.sh deploy/all.
MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD
PLATFORM_DB_USERNAME=qianruo_platform
PLATFORM_DB_PASSWORD=CHANGE_ME_PLATFORM_DB_PASSWORD
MERCHANT_DB_USERNAME=qianruo_merchant
MERCHANT_DB_PASSWORD=CHANGE_ME_MERCHANT_DB_PASSWORD
BUSINESS_DB_USERNAME=qianruo_business
BUSINESS_DB_PASSWORD=CHANGE_ME_BUSINESS_DB_PASSWORD
# Base64 encoded secret whose decoded length is at least 32 bytes.
NACOS_AUTH_TOKEN=CHANGE_ME_BASE64_SECRET_AT_LEAST_32_BYTES
NACOS_AUTH_IDENTITY_KEY=serverIdentity
NACOS_AUTH_IDENTITY_VALUE=CHANGE_ME_IDENTITY_VALUE

# File uploads use OSS. Endpoint, bucket and the shared Aliyun AccessKey are
# managed in the platform system configuration, not in deployment environment variables.
FILE_STORAGE_PROVIDER=aliyun-oss

# Docker build/runtime base images. Change these when a registry is unreachable.
# The Java image uses Microsoft Container Registry instead of Docker Hub by default.
JAVA_BASE_IMAGE=mcr.microsoft.com/openjdk/jdk:17-ubuntu
# Non-Alpine Nginx image accelerated by a registry reachable from China.
NGINX_BASE_IMAGE=m.daocloud.io/docker.io/library/nginx:1.27
MYSQL_IMAGE=mysql:8.4
# Debian-based Redis image accelerated by a registry reachable from China.
REDIS_IMAGE=m.daocloud.io/docker.io/library/redis:7.4
NACOS_IMAGE=nacos/nacos-server:v3.0.2

# Build/deploy switches.
BUILD_BACKEND=true
BUILD_FRONTEND=true
PUSH_IMAGES=true
APPLY_MANIFESTS=true

# First-time database bootstrapping is destructive for RuoYi base tables.
# Keep false for upgrades. Use true only on a fresh namespace/database.
INIT_DB=false
CONFIRM_INIT_DB=no
# Apply idempotent schema upgrades during normal deployments.
MIGRATE_DB=true

# JVM options used by all backend services.
JAVA_OPTS=-Xms256m -Xmx512m -Duser.timezone=Asia/Shanghai

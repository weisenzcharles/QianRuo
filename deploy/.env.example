# Copy this file to deploy/.env and adjust values before deployment.

# Container registry. For Volcengine CR, use the registry address from your namespace page.
REGISTRY=cr-<region>.volces.com
IMAGE_NAMESPACE=qianruo
IMAGE_TAG=latest

# Kubernetes target.
K8S_NAMESPACE=qianruo
KUBE_CONTEXT=

# Optional ingress hosts. Leave empty if your cloud load balancer binds later.
ADMIN_HOST=admin.example.com
MERCHANT_HOST=merchant.example.com

# Runtime secrets. Replace before running ./scripts/deploy.sh deploy/all.
MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# Base64 encoded secret whose decoded length is at least 32 bytes.
NACOS_AUTH_TOKEN=CHANGE_ME_BASE64_SECRET_AT_LEAST_32_BYTES
NACOS_AUTH_IDENTITY_KEY=serverIdentity
NACOS_AUTH_IDENTITY_VALUE=CHANGE_ME_IDENTITY_VALUE

# Local Docker base images. Change these when Docker Hub is unreachable.
MYSQL_IMAGE=mysql:8.4
REDIS_IMAGE=redis:7.2.14
NACOS_IMAGE=nacos/nacos-server:v3.0.2

# Build/deploy switches.
BUILD_BACKEND=true
BUILD_FRONTEND=true
PUSH_IMAGES=true
APPLY_MANIFESTS=true

# First-time database bootstrapping is destructive for RuoYi base tables.
# Keep false for upgrades. Use true only on a fresh namespace/database.
INIT_DB=false
CONFIRM_INIT_DB=no

# JVM options used by all backend services.
JAVA_OPTS=-Xms256m -Xmx512m
